# Environment Variables Template
# Copy this file to .env.local and fill in your values

# API Configuration
# Primary API - handles all authentication operations (login, register, OTP, forgot password)
NEXT_PUBLIC_PRIMARY_API_URL=https://ev-backend-six.vercel.app/api

# Secondary API - handles all data operations (customers, stations, trips, submissions)
NEXT_PUBLIC_SECONDARY_API_URL=https://ev-backend-six.vercel.app/api

# Application Configuration
NEXT_PUBLIC_APP_NAME=EVJoints Admin Dashboard
NEXT_PUBLIC_APP_VERSION=1.0.0